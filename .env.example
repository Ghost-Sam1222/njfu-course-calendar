# Copy to .env for local testing. Do not commit .env.
JW_BASE_URL=https://jwxt.njfu.edu.cn
JW_USERNAME=replace-with-your-student-id
JW_PASSWORD=replace-with-your-password

# Optional. If omitted, the script first tries the Qiangzhi teaching-week API,
# then falls back to date rules.
# Example for autumn 2026:
JW_SEMESTER=2026-2027-1

# Optional. This is the Monday of teaching week 1.
# If omitted, the script first tries the Qiangzhi teaching-week API,
# then falls back to:
# - autumn term: Monday on or before September 1
# - spring term: Monday on or before Lantern Festival
# Set this manually if the school calendar has a special start date.
TERM_FIRST_MONDAY=

# Optional knobs.
TERM_WEEKS=20
CALENDAR_NAME=南林课表
CALENDAR_TIMEZONE=Asia/Shanghai
CALENDAR_REFRESH_INTERVAL=PT6H

# Comma-separated dates or ranges to skip for normal classes.
# Example:
# EXCLUDE_DATES=2026-04-04..2026-04-06,2026-05-01..2026-05-05,2026-06-19
EXCLUDE_DATES=

# Dates that should keep normal classes even if they are legal holidays.
# Example:
# MAKEUP_DATES=2026-05-04
MAKEUP_DATES=

# Weekend or special makeup days that follow another date's timetable.
# Format: ACTUAL_DATE=SOURCE_DATE. Example:
# MAKEUP_DAY_MAP=2026-05-09=2026-05-04
MAKEUP_DAY_MAP=

# Automatically skip legal holidays from an external iCalendar source.
# Defaults to YangH9/ChinaCalendar when HOLIDAY_ICS_URLS is empty.
AUTO_EXCLUDE_HOLIDAYS=true
HOLIDAY_ICS_URLS=

# Optional workflow guards. GitHub Actions reads these from Variables.
SYNC_ENABLED=true
SYNC_UNTIL=

# Experimental: add final exam arrangements if the school's exam page is available.
INCLUDE_EXAMS=false
EXAM_URLS=
